{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "视频交付下载器默认权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "dialog:default",
    "dialog:allow-open",
    "opener:default",
    "opener:allow-open-path",
    "updater:default",
    "process:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://118.196.33.51/*" },
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    }
  ]
}
